<div class="w-full max-w-7xl mx-auto py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-white tracking-tight">Dashboard</h1>
    <div class="flex items-center space-x-4">
      <% if current_user.admin? %>
        <%= link_to "Admin Settings", "#", class: "text-sm text-neutral-400 hover:text-white transition-colors" %>
      <% end %>
      <div class="flex items-center space-x-2">
        <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-sm font-medium text-white shadow-sm ring-1 ring-white/10">
          <%= current_user.name&.first || current_user.email.first.upcase %>
        </div>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-sm text-neutral-400 hover:text-white transition-colors" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-neutral-800/40 rounded-2xl border border-neutral-700/50 p-6 flex flex-col justify-between relative overflow-hidden group">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <p class="text-sm font-medium text-neutral-400 mb-2">Total Uploads</p>
      <h3 class="text-4xl font-bold text-white tracking-tight"><%= @total_uploads %></h3>
    </div>

    <div class="bg-neutral-800/40 rounded-2xl border border-neutral-700/50 p-6 flex flex-col justify-between relative overflow-hidden group">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <p class="text-sm font-medium text-neutral-400 mb-2">Total Views</p>
      <h3 class="text-4xl font-bold text-white tracking-tight"><%= @total_views %></h3>
    </div>

    <div class="bg-neutral-800/40 rounded-2xl border border-neutral-700/50 p-6 flex flex-col justify-between relative overflow-hidden group">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <p class="text-sm font-medium text-neutral-400 mb-2">Storage Used</p>
      <h3 class="text-4xl font-bold text-white tracking-tight"><%= number_to_human_size(@storage_used || 0) %></h3>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <div class="bg-neutral-800/40 rounded-2xl border border-neutral-700/50 overflow-hidden">
        <div class="border-b border-neutral-700/50 px-6 py-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-white">Recent Uploads</h2>
        </div>

        <ul role="list" class="divide-y divide-neutral-800/50">
          <% @uploads.each do |upload| %>
            <li class="px-6 py-4 flex items-center justify-between hover:bg-neutral-800/60 transition-colors group">
              <div class="flex items-center space-x-4 min-w-0">
                <div class="w-12 h-12 rounded-lg bg-neutral-900 border border-neutral-700/50 flex items-center justify-center overflow-hidden shrink-0">
                  <% if upload.file.attached? && upload.file.image? %>
                    <%= image_tag upload.file.variant(resize_to_limit: [100, 100]), class: "w-full h-full object-cover" %>
                  <% else %>
                    <svg class="w-6 h-6 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                  <% end %>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center space-x-2">
                    <p class="text-sm font-medium text-white truncate"><%= upload.name || upload.slug %></p>
                    <span class="inline-flex items-center justify-center rounded-full bg-neutral-900/50 px-2 py-0.5 text-xs font-mono text-neutral-400 ring-1 ring-inset ring-neutral-700"><%= upload.slug %></span>
                  </div>
                  <p class="text-xs text-neutral-500 truncate mt-1">
                    <%= upload.file.attached? ? number_to_human_size(upload.file.byte_size) : "0 Bytes" %> &middot;
                    <%= time_ago_in_words(upload.created_at) %> ago &middot;
                    <%= pluralize(upload.views, 'view') %>
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                <button type="button" onclick="copyToClipboard('<%= upload_url(upload) %>')" class="p-1.5 text-neutral-400 hover:text-white hover:bg-neutral-700/50 rounded-md transition-colors" title="Copy URL">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                  </svg>
                </button>
                <%= button_to upload_path(upload), method: :delete, class: "p-1.5 text-red-400 hover:text-red-300 hover:bg-red-900/30 rounded-md transition-colors", form: { data: { turbo_confirm: 'Are you sure?' } }, title: "Delete" do %>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                <% end %>
              </div>
            </li>
          <% end %>

          <% if @uploads.empty? %>
            <li class="px-6 py-12 text-center">
              <svg class="mx-auto h-12 w-12 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-white">No files</h3>
              <p class="mt-1 text-sm text-neutral-500">Get started by uploading a file.</p>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div>
      <div class="bg-neutral-800/40 rounded-2xl border border-neutral-700/50 p-6 sticky top-8">
        <h2 class="text-lg font-semibold text-white mb-4">Upload File</h2>

        <div id="dropzone" class="border-2 border-dashed border-neutral-700 rounded-xl p-8 text-center transition-colors hover:bg-neutral-800/60 hover:border-indigo-500 cursor-pointer">
          <svg class="mx-auto h-10 w-10 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
          <div class="mt-4 flex text-sm leading-6 text-neutral-400 justify-center">
            <span class="relative cursor-pointer rounded-md font-semibold text-indigo-400 hover:text-indigo-300">
              <span>Click to upload</span>
              <input id="file-upload" name="file-upload" type="file" class="sr-only">
            </span>
            <p class="pl-1">or drag and drop</p>
          </div>
          <p class="text-xs leading-5 text-neutral-500 mt-1">PNG, JPG, GIF up to 10MB</p>
        </div>

        <div class="mt-6 border-t border-neutral-700/50 pt-6">
          <h3 class="text-sm font-medium text-white mb-2">API Token</h3>
          <div class="flex items-center space-x-2">
            <input type="text" readonly value="<%= current_user.token %>" class="block w-full rounded-md border-0 bg-neutral-900 py-1.5 text-neutral-400 shadow-sm ring-1 ring-inset ring-neutral-700 sm:text-sm sm:leading-6 font-mono text-center blur-sm hover:blur-none transition-all cursor-crosshair focus:blur-none" id="api-token">
            <button type="button" onclick="copyToClipboard('<%= current_user.token %>')" class="shrink-0 p-2 text-neutral-400 hover:text-white hover:bg-neutral-700/50 rounded-md ring-1 ring-inset ring-neutral-700 transition-colors" title="Copy Token">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
              </svg>
            </button>
          </div>
          <p class="text-xs text-neutral-500 mt-2">Use this token to authenticate API requests for uploading from ShareX or other clients.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
      // Create a toast manually or indicate success
      alert('Copied to clipboard!');
    });
  }

  // Basic file upload handling
  document.addEventListener('turbo:load', () => {
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-upload');

    if (!dropzone || !fileInput) return;

    dropzone.addEventListener('click', () => fileInput.click());

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-indigo-500', 'bg-neutral-800/60');
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-indigo-500', 'bg-neutral-800/60');
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-indigo-500', 'bg-neutral-800/60');

      if (e.dataTransfer.files.length) {
        uploadFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length) {
        uploadFile(fileInput.files[0]);
      }
    });

    function uploadFile(file) {
      const formData = new FormData();
      formData.append('file', file);

      const token = document.querySelector('meta[name="csrf-token"]').content;

      fetch('/uploads', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': token,
          'Accept': 'application/json'
        },
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.url) {
          window.location.reload();
        } else {
          alert('Upload failed: ' + (data.errors ? data.errors.join(', ') : 'Unknown error'));
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Upload failed');
      });
    }
  });
</script>
    <div class="mt-8 bg-neutral-800/40 rounded-2xl border border-neutral-700/50 p-6">
      <h2 class="text-lg font-semibold text-white mb-6">Uploads (Last 7 Days)</h2>
      <div class="h-64">
        <canvas id="uploadsChart"></canvas>
      </div>
    </div>

<script type="module">
  document.addEventListener("turbo:load", () => {
    const ctx = document.getElementById('uploadsChart');
    if (!ctx) return;
    
    // Check if chart instance exists and destroy it to prevent memory leaks
    if (window.uploadsChartInstance) {
      window.uploadsChartInstance.destroy();
    }
    
    const rawData = <%= raw @uploads_by_day.to_json %>;
    
    // Generate last 7 days keys
    const labels = [];
    const counts = [];
    
    for(let i=6; i>=0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const key = d.toISOString().split('T')[0];
      labels.push(d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }));
      counts.push(rawData[key] || 0);
    }

    if (typeof window.Chart !== 'undefined') {
      window.uploadsChartInstance = new window.Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Uploads',
            data: counts,
            borderColor: '#6366f1',
            backgroundColor: 'rgba(99, 102, 241, 0.1)',
            borderWidth: 2,
            pointBackgroundColor: '#6366f1',
            pointBorderColor: '#fff',
            pointHoverBackgroundColor: '#fff',
            pointHoverBorderColor: '#6366f1',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { precision: 0, color: '#9ca3af' },
              grid: { color: 'rgba(75, 85, 99, 0.2)' },
              border: { display: false }
            },
            x: {
              ticks: { color: '#9ca3af' },
              grid: { display: false },
              border: { display: false }
            }
          }
        }
      });
    }
  });
</script>
